# ─────────────────────────────────────────────────────────────────────────────
# Copie para .env.local (na raiz) e ajuste. Nunca versione .env.local.
# Os valores abaixo são os do Supabase local (`pnpm supabase start`).
# Rode `pnpm supabase status` para conferir as chaves da sua máquina.
# ─────────────────────────────────────────────────────────────────────────────

# Conexão da aplicação: role app_user, SEM bypass de RLS.
# A senha aqui é aplicada na role pelo `pnpm db:migrate`.
DATABASE_URL="postgresql://app_user:app_dev_password@127.0.0.1:54322/postgres"

# Conexão privilegiada: migrations, criação de escritório no signup, jobs.
DATABASE_ADMIN_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="cole-a-anon-key-do-supabase-status"
SUPABASE_SERVICE_ROLE_KEY="cole-a-service-role-key-do-supabase-status"

# Usuário criado pelo `pnpm db:seed`.
SEED_USER_EMAIL="dev@correspondente.local"
SEED_USER_PASSWORD="dev12345678"
